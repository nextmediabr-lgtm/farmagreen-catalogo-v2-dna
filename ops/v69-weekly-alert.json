      "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM" }],
      "comparison": "COMPARISON_GT",
      "thresholdValue": 0,
      "duration": "0s",
      "trigger": { "count": 1 }
    }
  }],
  "notificationChannels": ["projects/project-e2a7bc6d-e741-4d4e-85d/notificationChannels/REQUIERE_CANAL_CONFIRMADO"],
  "enabled": false
}
