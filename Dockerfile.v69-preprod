FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY scripts/build-v69-css.mjs ./scripts/build-v69-css.mjs
COPY scripts/build-v69-client.mjs ./scripts/build-v69-client.mjs
COPY public ./public
RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
ENV DEFAULT_ROUTE=/inicio/
ENV V69_ENABLE_PRODUCTION=1

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY --from=build /app/public ./public
COPY data ./data
COPY scripts ./scripts

USER node
EXPOSE 8080
CMD ["node", "dist/server.js"]
