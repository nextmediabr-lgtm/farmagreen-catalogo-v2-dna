FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY tests ./tests
COPY data ./data
COPY .gcloudignore ./
COPY public ./public
RUN npm run verify:container:v69

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
ENV DEFAULT_ROUTE=/inicio/
ENV V69_ENABLE_PRODUCTION=1
ENV V69_FALLBACK_CATALOG_FILE=/app/data/catalog-v69-fallback.json
ARG V69_CODE_REVISION=local
ENV V69_CODE_REVISION=${V69_CODE_REVISION}

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY --from=build /app/public ./public
COPY --chown=node:node data ./data
COPY scripts ./scripts

USER node
EXPOSE 8080
CMD ["node", "dist/server.js"]
